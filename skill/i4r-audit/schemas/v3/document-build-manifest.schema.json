{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i4r.example/schemas/v3/document-build-manifest.schema.json",
  "title": "I4R exact document build manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "transaction_id",
    "build_kind",
    "release_eligible",
    "inputs",
    "code",
    "renderers",
    "artifacts",
    "pages",
    "page_limit",
    "validations",
    "all_validations_passed"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "transaction_id": {"type": "string", "format": "uuid"},
    "build_kind": {"enum": ["canonical", "preview"]},
    "release_eligible": {"type": "boolean"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "front_matter", "captions", "policy_snapshot", "policy_sha256"],
      "properties": {
        "report": {"$ref": "#/$defs/artifact"},
        "front_matter": {"$ref": "#/$defs/artifact"},
        "captions": {"$ref": "#/$defs/artifact"},
        "policy_snapshot": {"$ref": "#/$defs/artifact"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "verifier", "cache_helper"],
      "properties": {
        "builder": {"$ref": "#/$defs/codeIdentity"},
        "verifier": {"$ref": "#/$defs/codeIdentity"},
        "cache_helper": {"$ref": "#/$defs/codeIdentity"}
      }
    },
    "renderers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown_to_docx", "docx_to_pdf", "pdf_page_counter", "pdf_text_extractor"],
      "properties": {
        "markdown_to_docx": {"$ref": "#/$defs/rendererIdentity"},
        "docx_to_pdf": {"$ref": "#/$defs/rendererIdentity"},
        "pdf_page_counter": {"$ref": "#/$defs/rendererIdentity"},
        "pdf_text_extractor": {"$ref": "#/$defs/rendererIdentity"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf", "docx"],
      "properties": {
        "pdf": {"$ref": "#/$defs/artifact"},
        "docx": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_pages",
        "body_pages",
        "back_matter_pages",
        "first_back_matter_page",
        "abstract_ending_page",
        "body_page_cap"
      ],
      "properties": {
        "total_pages": {"type": "integer", "minimum": 1},
        "body_pages": {"type": "integer", "minimum": 1},
        "back_matter_pages": {"type": "integer", "minimum": 0},
        "first_back_matter_page": {
          "oneOf": [{"type": "integer", "minimum": 2}, {"type": "null"}]
        },
        "abstract_ending_page": {"const": 1},
        "body_page_cap": {"type": "integer", "minimum": 1}
      }
    },
    "page_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "release_enforced"],
      "properties": {
        "value": {"type": "integer", "minimum": 1},
        "source": {"enum": ["hash_bound_policy_snapshot", "preview_cli"]},
        "release_enforced": {"type": "boolean"}
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/validation"}
    },
    "all_validations_passed": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "codeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "rendererIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "passed"},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
