{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i4replication.org/schemas/v2/invocation-record.schema.json",
  "title": "I4R metadata 2.1 model invocation projection",
  "description": "One terminal projection per lifecycle invocation. Metadata 2.1 separates provider request from accepted inference start, requested from served identity, honest telemetry disposition from numeric coverage, and aggregate from per-model usage. Pre-2.1 immutable rows remain valid.",
  "$defs": {
    "invocation_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obtainable",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "reasoning_tokens",
        "total_tokens",
        "source"
      ],
      "properties": {
        "obtainable": {
          "type": "boolean"
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "description": "Cache-read input tokens when separately exposed by the provider.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "description": "Cache-creation/write input tokens when separately exposed by the provider. Optional only for the pre-extension all-or-nothing v2 usage shape.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": "string",
          "enum": [
            "api_response",
            "cli_log",
            "dashboard_export",
            "unavailable"
          ]
        },
        "unavailable_reasons": {
          "description": "For the extended partial-usage shape, every null component has a non-empty reason and every observed component omits its reason. This makes absence explicit without fabricating zero tokens.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "string",
              "minLength": 1
            },
            "output_tokens": {
              "type": "string",
              "minLength": 1
            },
            "cached_input_tokens": {
              "type": "string",
              "minLength": 1
            },
            "cache_creation_input_tokens": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_tokens": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "total_tokens_kind": {
          "description": "Whether total_tokens was reported by the provider, derived exactly from named observed components, or unavailable.",
          "type": "string",
          "enum": [
            "provider_reported",
            "derived",
            "unavailable"
          ]
        },
        "total_tokens_components": {
          "description": "Unique observed components summed for a derived total; empty for provider-reported or unavailable totals.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "input_tokens",
              "output_tokens",
              "cached_input_tokens",
              "cache_creation_input_tokens",
              "reasoning_tokens"
            ]
          }
        },
        "total_tokens_unavailable_reason": {
          "description": "Non-empty exactly when total_tokens_kind is unavailable.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "semantics": {
          "description": "Provider-specific overlap semantics used when normalizing totals.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "cache_read_tokens",
            "cache_write_tokens",
            "reasoning_tokens",
            "normalized_total"
          ],
          "properties": {
            "input_tokens": {
              "type": "string",
              "enum": [
                "fresh_only",
                "includes_cache_read",
                "provider_defined",
                "unknown"
              ]
            },
            "cache_read_tokens": {
              "type": "string",
              "enum": [
                "additional",
                "subset_of_input",
                "provider_defined",
                "unknown"
              ]
            },
            "cache_write_tokens": {
              "type": "string",
              "enum": [
                "additional",
                "subset_of_input",
                "provider_defined",
                "unknown"
              ]
            },
            "reasoning_tokens": {
              "type": "string",
              "enum": [
                "additional",
                "subset_of_output",
                "provider_defined",
                "unknown"
              ]
            },
            "normalized_total": {
              "type": "string",
              "enum": [
                "provider_reported",
                "non_overlapping_components",
                "unavailable"
              ]
            }
          }
        }
      }
    },
    "provider_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "source",
        "unavailable_reason"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "api_response",
            "cli_log",
            "dashboard_export",
            "unavailable"
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "attempt_kind"
        ]
      },
      "then": {
        "required": [
          "attempt_kind",
          "provider_request_status",
          "inference_start_status",
          "source_invocation_id",
          "turn_count",
          "provider_cost",
          "served_model",
          "identity_assurance",
          "model_identity_evidence",
          "usage_by_model",
          "unattributed_usage",
          "provider_duration_seconds"
        ]
      }
    }
  ],
  "required": [
    "invocation_id",
    "role",
    "role_class",
    "round",
    "attempt",
    "status",
    "provider",
    "provider_call",
    "cache_usage",
    "session_id",
    "requested_model",
    "observed_model",
    "model_family",
    "model_source",
    "reasoning_effort",
    "started_at",
    "ended_at",
    "elapsed_seconds",
    "input_artifact_sha256",
    "prompt_sha256",
    "output_artifact",
    "output_sha256",
    "usage",
    "error",
    "error_class",
    "legacy_source"
  ],
  "properties": {
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "role_class": {
      "type": "string",
      "enum": [
        "coordinator",
        "auditor",
        "adjudicator",
        "critic",
        "synthesizer",
        "verifier",
        "other"
      ]
    },
    "round": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "attempt": {
      "description": "Role-budget attempt allocated only at an accepted inference start; null for preflight, rejected schema admission, or cache replay.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "attempt_ceiling": {
      "description": "Accepted inference starts allowed for this role and round when the attempt was allocated. Projected from the journal, never authored.",
      "type": [
        "integer",
        "null"
      ]
    },
    "attempt_ceiling_source": {
      "description": "Which knob set attempt_ceiling: the protocol default or the operator's I4R_MAX_ATTEMPTS.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "protocol_default",
        "I4R_MAX_ATTEMPTS",
        null
      ]
    },
    "attempt_ceiling_applies": {
      "description": "Whether this attempt kind consumes the per-role budget at all; capability probes do not.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "attempt_kind": {
      "type": "string",
      "enum": [
        "local_preflight",
        "capability_probe",
        "schema_admission",
        "role_inference",
        "output_repair",
        "cache_replay"
      ]
    },
    "schema_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_request_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "accepted",
        "rejected",
        "unknown"
      ]
    },
    "inference_start_status": {
      "type": "string",
      "enum": [
        "not_started",
        "started",
        "unknown"
      ]
    },
    "source_invocation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "legacy_record"
      ]
    },
    "superseded_status": {
      "description": "The terminal status this record carried before an invocation_correction changed it. Set by projection, never authored. A superseded failure stays countable as a failure.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "started",
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "legacy_record",
        null
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_call": {
      "description": "True exactly when this record represents a provider call; false distinguishes cache reads and probe-cache metadata from paid calls.",
      "type": "boolean"
    },
    "cache_usage": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write",
        "read_write",
        "probe_cache",
        "not_applicable"
      ]
    },
    "session_id": {
      "description": "Provider session/thread/conversation identifier when exposed; null otherwise.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "requested_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_model": {
      "description": "Deprecated pre-2.1 alias of served_model. Never populate it from the requested route.",
      "type": [
        "string",
        "null"
      ]
    },
    "served_model": {
      "description": "Provider-observed served model ID; null when the adapter exposes only the requested route.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "identity_assurance": {
      "type": "string",
      "enum": [
        "observed",
        "requested_only",
        "unavailable"
      ]
    },
    "model_identity_evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source",
        "raw_ids",
        "artifact",
        "artifact_sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "api_response",
            "cli_log",
            "dashboard_export",
            "adapter",
            "unavailable"
          ]
        },
        "raw_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observed_model_ids": {
      "description": "Every distinct served model ID exposed for the invocation, including auxiliary models. observed_model remains the primary routed model used for policy and family checks.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_source": {
      "type": "string",
      "enum": [
        "observed",
        "declared",
        "inferred",
        "unavailable"
      ]
    },
    "reasoning_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra",
        "provider_default",
        "unknown"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "provider_duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "turn_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provider_cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/provider_cost"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_artifact": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "output_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "usage": {
      "$ref": "#/$defs/invocation_usage"
    },
    "usage_by_model": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "identity_assurance",
          "usage"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "identity_assurance": {
            "type": "string",
            "enum": [
              "observed",
              "requested_only"
            ]
          },
          "usage": {
            "$ref": "#/$defs/invocation_usage"
          }
        }
      }
    },
    "unattributed_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/invocation_usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "transient",
        "permanent",
        "schema",
        "authentication",
        "authorization",
        "quota",
        "model",
        "unsupported_model",
        "capability",
        "deterministic_schema",
        "throttling",
        "provider_5xx",
        "server_5xx",
        "timeout",
        "transport",
        "provider_safety_refusal",
        "output_limit",
        "environment",
        "unknown",
        null
      ]
    },
    "legacy_source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "model_assignment_index",
        "token_record_index"
      ],
      "properties": {
        "model_assignment_index": {
          "type": "integer",
          "minimum": 0
        },
        "token_record_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "journal_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "hash"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
