{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i4replication.org/schemas/v2/invocation-record.schema.json",
  "title": "I4R v2 model invocation record",
  "description": "One record per actual attempt. Requested and observed identity, reasoning effort, timing, artifacts, and usage stay together so retries and substitutions cannot be hidden by role-level aggregation. Unknown legacy values are explicit, never estimated.",
  "$defs": {
    "invocation_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obtainable", "input_tokens", "output_tokens", "cached_input_tokens", "reasoning_tokens", "total_tokens", "source"],
      "properties": {
        "obtainable": {"type": "boolean"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "source": {"type": "string", "enum": ["api_response", "cli_log", "dashboard_export", "unavailable"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "role",
    "role_class",
    "round",
    "attempt",
    "status",
    "provider",
    "provider_call",
    "cache_usage",
    "session_id",
    "requested_model",
    "observed_model",
    "model_family",
    "model_source",
    "reasoning_effort",
    "started_at",
    "ended_at",
    "elapsed_seconds",
    "input_artifact_sha256",
    "prompt_sha256",
    "output_artifact",
    "output_sha256",
    "usage",
    "error",
    "error_class",
    "legacy_source"
  ],
  "properties": {
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "role_class": {
      "type": "string",
      "enum": [
        "coordinator",
        "auditor",
        "adjudicator",
        "critic",
        "synthesizer",
        "other"
      ]
    },
    "round": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "legacy_record"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_call": {
      "description": "True exactly when this record represents a provider call; false distinguishes cache reads and probe-cache metadata from paid calls.",
      "type": "boolean"
    },
    "cache_usage": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write",
        "read_write",
        "probe_cache"
      ]
    },
    "session_id": {
      "description": "Provider session/thread/conversation identifier when exposed; null otherwise.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "requested_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_source": {
      "type": "string",
      "enum": [
        "observed",
        "declared",
        "inferred",
        "unavailable"
      ]
    },
    "reasoning_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra",
        "provider_default",
        "unknown"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "input_artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_artifact": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "output_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "usage": {
      "$ref": "#/$defs/invocation_usage"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "transient",
        "permanent",
        "schema",
        "authentication",
        "authorization",
        "quota",
        "model",
        "timeout",
        "transport",
        "unknown",
        null
      ]
    },
    "legacy_source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "model_assignment_index",
        "token_record_index"
      ],
      "properties": {
        "model_assignment_index": {
          "type": "integer",
          "minimum": 0
        },
        "token_record_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
